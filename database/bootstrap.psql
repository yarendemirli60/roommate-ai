-- Run manually as a PostgreSQL administrator against the postgres database.
-- No DROP, reset, role password literal, user data or database dump is included.
\set ON_ERROR_STOP on
SELECT current_database(), current_user;
SHOW port;
SELECT EXISTS(SELECT 1 FROM pg_roles WHERE rolname = 'roommate_app') AS app_role_exists \gset
\if :app_role_exists
    \echo Existing roommate_app role preserved. Its password is not changed.
\else
    CREATE ROLE roommate_app LOGIN;
    \echo Set a new local password interactively; put the same value in your untracked .env.
    \password roommate_app
\endif
SELECT format('CREATE DATABASE %I OWNER %I', 'roommate_ai', 'roommate_app')
WHERE NOT EXISTS(SELECT 1 FROM pg_database WHERE datname = 'roommate_ai')
\gexec
\connect roommate_ai
GRANT CONNECT ON DATABASE roommate_ai TO roommate_app;
GRANT USAGE, CREATE ON SCHEMA public TO roommate_app;
\echo Existing tables and data were preserved. Next run the existing Django migrations, then messaging_matches.sql.
